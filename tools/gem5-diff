#!/usr/bin/env python3
"""Lists how gem5/ differs from upstream gem5 v24.0.0.0.

Clones upstream (shallow, once) into build/upstream-gem5 and compares every
tracked file under gem5/. Keep gem5/PATCHES.md in sync with this output.
"""

import filecmp
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
UPSTREAM = ROOT / "build" / "upstream-gem5"
TAG = "v24.0.0.0"
# Ramulator2 is a research fork with no clean upstream; see gem5/PATCHES.md.
FORK = "ext/ramulator2/ramulator2/"


def main() -> None:
    """Prints modified and added files relative to upstream."""
    if not UPSTREAM.exists():
        subprocess.run(
            ["git", "-c", "advice.detachedHead=false", "clone", "-q", "--depth", "1",
             "--branch", TAG,
             "https://github.com/gem5/gem5.git", str(UPSTREAM)],
            check=True,
        )
    tracked = subprocess.run(
        ["git", "ls-files", "gem5"], cwd=ROOT, capture_output=True,
        text=True, check=True,
    ).stdout.split()
    modified, added = [], []
    for path in (p[len("gem5/"):] for p in tracked):
        upstream = UPSTREAM / path
        if not upstream.exists():
            added.append(path)
        elif not filecmp.cmp(ROOT / "gem5" / path, upstream, shallow=False):
            modified.append(path)
    print(f"Modified upstream files ({len(modified)}):")
    for path in modified:
        print(f"  M {path}")
    fork = [p for p in added if p.startswith(FORK)]
    print(f"Added files ({len(added) - len(fork)}, plus {len(fork)} in the "
          f"Ramulator2 fork):")
    for path in added:
        if not path.startswith(FORK):
            print(f"  + {path}")


if __name__ == "__main__":
    main()
